<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Shaped like a project generated by Spring Initializr, with the two fullstack4j starters as
	     its only dependencies: Spring Boot's own parent manages every version, and nothing here
	     inherits this build's dependency management, so the test proves the starters' published poms
	     are enough on their own. -->
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>@spring-boot.version@</version>
		<relativePath/>
	</parent>

	<groupId>com.example</groupId>
	<artifactId>boot-managed-versions</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>@project.groupId@</groupId>
			<artifactId>fullstack4j-spring-boot-starter</artifactId>
			<version>@project.version@</version>
		</dependency>

		<dependency>
			<groupId>@project.groupId@</groupId>
			<artifactId>fullstack4j-spring-boot-starter-test</artifactId>
			<version>@project.version@</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>check-resolved-dependencies</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<!-- Wicket Oat brings an older Wicket; the starter must win, everywhere -->
								<requireSameVersions>
									<dependencies>
										<dependency>org.apache.wicket:*</dependency>
									</dependencies>
								</requireSameVersions>
								<!-- Development-only tools are the application's choice, never the starters' -->
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework.boot:spring-boot-docker-compose</exclude>
										<exclude>org.springframework.boot:spring-boot-devtools</exclude>
										<exclude>com.julien-dubois.bootui</exclude>
									</excludes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
